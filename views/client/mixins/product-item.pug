mixin product-item(item)
  .col-4.mb-3
    .product-item.border.p-2.h-100.d-flex.flex-column
      .inner-image
        img(
          src=item.thumbnail 
          alt=item.title
          class="w-100 h-100 object-fit-cover"
          )
        if(item.featured==="1")
          .inner-featured Nổi bật
      .inner-content.mt-2.flex-grow-1 
        h3.inner-title
          a(href=`/products/${item.slug}`) #{item.title}
        .inner-price-new #{item.priceNew}$
        .inner-price-old #{item.price}$
        .inner-discount #{item.discountPercentage}%