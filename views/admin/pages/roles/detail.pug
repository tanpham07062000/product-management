extends ../../layouts/default.pug

block main
  .card-header
    h1.mb-0 Chi tiết nhóm quyền

  .card-body
    if(record.title)
      p.mb-2
        span.fw-semibold Tên nhóm quyền:
        span.ms-2 #{record.title}

    if(record.description)
      p.mb-3
        span.fw-semibold Miêu tả:
        span.ms-2 #{record.description}

    a.btn.btn-primary(
      href=`/admin/roles/edit/${record._id}`
    ) Chỉnh sửa